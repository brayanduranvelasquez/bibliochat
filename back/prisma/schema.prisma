// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int             @id @default(autoincrement())
  email            String          @unique
  password         String
  isVerified       Boolean         @default(true) // Always verified for demo
  currentChallenge String? // Store pending WebAuthn challenge
  profile          Profile?
  authenticators   Authenticator[]

  conversations Conversation[]
}

model Authenticator {
  // Use String for credentialID because WebAuthn IDs can be base64url encoded
  credentialID         String  @id
  userId               Int
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Store these as Bytes/Buffers for cryptographic verification
  publicKey            Bytes
  counter              BigInt
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String? // Comma-separated list
  name                 String  @default("Dispositivo")

  @@index([userId])
}

model Profile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
}

model Book {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  published   Boolean @default(false)
  authorId    Int
  author      Profile @relation(fields: [authorId], references: [id])
}

model Conversation {
  id        Int                   @id @default(autoincrement())
  userId    Int
  user      User                  @relation(fields: [userId], references: [id])
  slug      String                @unique
  title     String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messages  ConversationMessage[]
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           String // 'user' | 'assistant' | 'error'
  content        String
  createdAt      DateTime     @default(now())
}
